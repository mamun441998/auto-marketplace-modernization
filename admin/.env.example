# Base URL of the Laravel API (super-admin routes live under /api/admin/*)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Where the public marketing/auth app lives (for logout / login redirects)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Where the dealer dashboard lives (used by the "Impersonate dealer" action)
NEXT_PUBLIC_DEALER_URL=http://localhost:3001
